{
  "name": "dsh-mnemos",
  "version": "0.3.0",
  "description": "DSH 的本地长期记忆插件：记录、热度、情绪与上下文预算，零运行时依赖",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "client.js",
    "cordis.patch.yml",
    "src",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "preview": "node scripts/preview-panel.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tletletle/dsh-mnemos.git"
  },
  "bugs": {
    "url": "https://github.com/tletletle/dsh-mnemos/issues"
  },
  "homepage": "https://github.com/tletletle/dsh-mnemos#readme",
  "author": "tletletle",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "long-term-memory",
    "companion"
  ],
  "license": "MIT"
}
